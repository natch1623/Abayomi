node_modules/
dist/
build/
.cache/
.env*
.vite/
vite.config.*.timestamp-*
*.tsbuildinfo
*-debug.log*
logs/
*.log
.claude-replay.*
.tmp-*

# Platform-managed agentplat state, not project source. In the
# client-initiated single-repo workspace layout (make's `Path: "."` spec) the
# repo root IS the workspace root, so these land inside this repo rather than
# beside it.
/.plugins/
/.opencode-skills/

# Las fotos personales de Nicole no se publican, ni las originales ni las
# versiones ligeras. Viven solo en este equipo.
/Fotos/
/web/Fotos/

# De las cartas se publica solo la versión ligera de web/Cartas/. Los originales
# de varios megas se quedan aquí; para regenerar las ligeras tras añadir alguna:
#   node scripts/optimizar-imagenes.mjs
/Cartas/**/*.png
/Cartas/**/*.jpg
/Cartas/**/*.jpeg
# El video, el SVG y la carta en HTML no tienen versión ligera: la web los lee
# de Cartas/ directamente, así que sí se publican.
